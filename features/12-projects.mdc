# 项目系统 (Projects)

## 概述

项目是城市可以进行的特殊生产活动，消耗生产力但不产生实体建筑或单位。项目通常用于获得伟人点数、触发特殊效果或推进胜利条件。

---

## 一、项目数据结构

```typescript
interface Project {
  id: string;
  name: string;
  category: ProjectCategory;
  
  // 建造要求
  productionCost: number;
  requiredDistrict?: string;      // 需要特定区域
  requiredTech?: string;
  requiredCivic?: string;
  requiredBuilding?: string;
  repeatable: boolean;             // 是否可重复建造
  
  // 效果
  onComplete: ProjectEffect[];
  
  // 特殊
  turnsRequired?: number;          // 固定回合数（不受生产力影响）
}

enum ProjectCategory {
  DISTRICT = 'district',           // 区域项目（伟人点数）
  VICTORY = 'victory',             // 胜利条件项目
  CONVERSION = 'conversion',       // 转化项目（核武器等）
  MILITARY = 'military',           // 军事项目
  SPECIAL = 'special',             // 特殊项目
}

interface ProjectEffect {
  type: ProjectEffectType;
  value: number;
  target?: string;
}

enum ProjectEffectType {
  GREAT_PERSON_POINTS = 'great_person_points',
  GOLD = 'gold',
  SCIENCE = 'science',
  CULTURE = 'culture',
  FAITH = 'faith',
  PRODUCTION = 'production',
  UNIT_SPAWN = 'unit_spawn',
  TRIGGER_EVENT = 'trigger_event',
  VICTORY_PROGRESS = 'victory_progress',
}
```

