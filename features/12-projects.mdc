## 七、项目生产逻辑

```typescript
// 区域项目的伟人点数计算
function calculateDistrictProjectRewards(
  project: Project,
  productionInvested: number
): ProjectReward {
  const rewards: ProjectReward = {
    greatPersonPoints: {},
    yields: {},
  };
  
  // 每100生产力 = 2伟人点数
  const gpPointsMultiplier = Math.floor(productionInvested / 100);
  
  for (const effect of project.onComplete) {
    if (effect.type === ProjectEffectType.GREAT_PERSON_POINTS) {
      rewards.greatPersonPoints[effect.target!] = effect.value * gpPointsMultiplier;
    } else if (effect.type === ProjectEffectType.SCIENCE) {
      rewards.yields.science = effect.value;
    } else if (effect.type === ProjectEffectType.FAITH) {
      rewards.yields.faith = effect.value;
    } else if (effect.type === ProjectEffectType.GOLD) {
      rewards.yields.gold = effect.value;
    }
  }
  
  return rewards;
}

// 项目完成处理
function completeProject(city: City, project: Project): void {
  for (const effect of project.onComplete) {
    switch (effect.type) {
      case ProjectEffectType.GREAT_PERSON_POINTS:
        addGreatPersonPoints(city.owner, effect.target!, effect.value);
        break;
        
      case ProjectEffectType.UNIT_SPAWN:
        spawnUnit(city, effect.target!, effect.value);
        break;
        
      case ProjectEffectType.VICTORY_PROGRESS:
        incrementVictoryProgress(city.owner, effect.target!, effect.value);
        break;
        
      case ProjectEffectType.TRIGGER_EVENT:
        triggerGameEvent(effect.target!, { city, player: city.owner });
        break;
        
      default:
        // 产出效果
        addYieldToCity(city, effect.type, effect.value);
    }
  }
  
  // 检查胜利条件
  checkVictoryConditions(city.owner);
}
```

