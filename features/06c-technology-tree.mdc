## 六、科技数据结构

```typescript
interface Technology {
  id: string;
  name: string;
  era: Era;
  cost: number;
  prerequisites: string[];
  eureka: Eureka | null;
  unlocks: TechUnlocks;
  quotes?: string[];  // 解锁时的名言
}

interface TechUnlocks {
  units?: string[];
  buildings?: string[];
  districts?: string[];
  improvements?: string[];
  wonders?: string[];
  abilities?: string[];
  resources?: string[];  // 揭示的资源
  projects?: string[];   // 解锁的项目
}

interface Eureka {
  description: string;
  conditionType: EurekaConditionType;
  conditionValue: any;
  bonus: number;  // 默认 0.5 (50%)
}

enum Era {
  ANCIENT = 'ancient',
  CLASSICAL = 'classical',
  MEDIEVAL = 'medieval',
  RENAISSANCE = 'renaissance',
  INDUSTRIAL = 'industrial',
  MODERN = 'modern',
  ATOMIC = 'atomic',
  INFORMATION = 'information',
}
```

