## 二、地块数据结构

```typescript
interface Tile {
  // 位置
  position: Coord;
  
  // 地形层次（详见 05a-terrain-features.mdc）
  terrain: TerrainType;       // 基础地形（草原/平原/沙漠等）
  elevation: Elevation;        // 高度（平地/丘陵/山脉）
  feature: FeatureType | null; // 地貌特征（森林/雨林/沼泽等）
  
  // 资源（详见 05b-resources-biomes.mdc）
  resource: ResourceType | null;
  hiddenResource: ResourceType | null; // 未揭示的战略资源
  
  // 人造物
  improvement: ImprovementType | null;
  district: DistrictType | null;
  wonder: WonderType | null;
  road: RoadLevel;            // 0=无, 1=古代道路, 2=铁路
  
  // 边缘元素
  rivers: Direction[];        // 哪些边有河流
  cliffs: Direction[];        // 哪些边有悬崖
  
  // 归属
  owner: PlayerId | null;     // 领土归属
  city: CityId | null;        // 所属城市
  
  // 状态
  pillaged: boolean;          // 是否被劫掠
  contaminated: boolean;      // 核污染
  appealModifier: number;     // 魅力修正
}

interface Coord {
  row: number;
  col: number;
}
