## 七、视野与迷雾

```typescript
enum VisibilityState {
  UNEXPLORED = 'unexplored',  // 未探索（黑色）
  FOG = 'fog',                // 迷雾（曾探索但当前不可见）
  VISIBLE = 'visible',        // 可见
}

interface VisibilityMap {
  tiles: VisibilityState[][];
}

// 单位视野计算
function calculateVisibility(unit: Unit, map: GameMap): Coord[] {
  const visible: Coord[] = [];
  const center = unit.position;
  const range = unit.sight;
  
  // 获取范围内所有地块
  const tilesInRange = getTilesInRange(center.row, center.col, range, map.width, map.height);
  
  for (const tile of tilesInRange) {
    // 检查视线是否被阻挡（山脉、森林丘陵）
    if (!isLineOfSightBlocked(center, tile, map)) {
      visible.push(tile);
    }
  }
  
  return visible;
}
```

