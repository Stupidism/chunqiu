## 十四、图标使用指南

### React 组件封装

```tsx
// packages/ui/src/components/Icon.tsx
import { cn } from '@/lib/utils';

interface IconProps {
  name: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  className?: string;
}

const sizeMap = {
  xs: 'w-4 h-4',
  sm: 'w-6 h-6',
  md: 'w-8 h-8',
  lg: 'w-12 h-12',
  xl: 'w-16 h-16',
};

export function Icon({ name, size = 'md', className }: IconProps) {
  return (
    <img
      src={`/icons/${name}.svg`}
      alt={name}
      className={cn(sizeMap[size], className)}
      loading="lazy"
    />
  );
}

// 使用示例
<Icon name="civilizations/qin" size="lg" />
<Icon name="city-states/cultural/cao" size="md" />
<Icon name="yields/禾" size="sm" />
```
