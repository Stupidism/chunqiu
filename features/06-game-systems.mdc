## 游戏状态结构

```typescript
interface GameState {
  // 游戏元信息
  gameId: string;
  turn: number;
  era: Era;
  gameSpeed: GameSpeed;
  
  // 地图
  map: {
    width: number;
    height: number;
    tiles: Tile[][];
  };
  
  // 玩家
  players: PlayerState[];
  currentPlayerId: string | null;
  
  // 全局
  barbarians: BarbarianCamp[];
  cityStates: CityState[];
  greatPeople: GreatPerson[];
  religions: Religion[];
}

interface PlayerState {
  id: string;
  civilization: Civilization;
  isAI: boolean;
  
  // 产出
  yields: YieldsSummary;
  treasury: number;
  
  // 实体
  cities: City[];
  units: Unit[];
  
  // 进度
  techs: string[];
  currentResearch: ResearchState | null;
  civics: string[];
  currentCivic: CivicState | null;
  
  // 政府
  government: string | null;
  policies: string[];
  
  // 宗教
  pantheon: string | null;
  religion: Religion | null;
  
  // 视野
  visibility: VisibilityMap;
  
  // 外交
  diplomacy: DiplomacyState;
  
  // 伟人
  greatPeoplePoints: Record<string, number>;
  
  // 统计
  score: number;
}
```

