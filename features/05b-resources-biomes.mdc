## 六、野生动物系统 (装饰性)

野生动物为地图增添生机，仅作装饰无游戏影响。

```typescript
interface WildAnimal {
  id: string;
  name: string;
  biomes: BiomeType[];  // 出现的生物群落
  sprite: string;       // 动画精灵
  movementPattern: 'stationary' | 'roaming' | 'herd';
  groupSize: { min: number; max: number };
}

const WILD_ANIMALS: WildAnimal[] = [
  {
    id: 'deer',
    name: '鹿',
    biomes: [BiomeType.TEMPERATE_FOREST, BiomeType.BOREAL_FOREST],
    sprite: 'deer',
    movementPattern: 'roaming',
    groupSize: { min: 2, max: 5 },
  },
  {
    id: 'elephant',
    name: '大象',
    biomes: [BiomeType.TROPICAL_RAINFOREST, BiomeType.TROPICAL_SAVANNA],
    sprite: 'elephant',
    movementPattern: 'herd',
    groupSize: { min: 3, max: 8 },
  },
  {
    id: 'wolf',
    name: '狼',
    biomes: [BiomeType.TEMPERATE_FOREST, BiomeType.BOREAL_FOREST, BiomeType.TUNDRA],
    sprite: 'wolf',
    movementPattern: 'roaming',
    groupSize: { min: 3, max: 6 },
  },
  // ... 更多动物
];
