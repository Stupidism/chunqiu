### 生成规则

1. **数量**：根据地图大小决定
   - 小地图：4-6 个
   - 标准地图：6-8 个
   - 大地图：8-12 个
   - 巨大地图：12-16 个

2. **间距**：自然奇观之间至少相距 10 个地块

3. **优先级**：中国特色奇观优先生成（`isChinese: true`）

4. **地形适配**：必须符合 `validTerrains` 和 `validElevations`

5. **平衡分布**：尽量分散在地图各处，避免集中

```typescript
function placeNaturalWonders(map: GameMap, count: number): void {
  const wonders = [...NATURAL_WONDERS]
    .sort((a, b) => (b.isChinese ? 1 : 0) - (a.isChinese ? 1 : 0)); // 中国奇观优先
  
  const placed: Coord[] = [];
  
  for (const wonder of wonders) {
    if (placed.length >= count) break;
    
    const position = findValidPosition(map, wonder, placed);
    if (position) {
      placeWonderAt(map, wonder, position);
      placed.push(position);
    }
  }
}

function findValidPosition(
  map: GameMap, 
  wonder: NaturalWonder, 
  existing: Coord[]
): Coord | null {
  const MIN_DISTANCE = 10;
  
  for (let attempt = 0; attempt < 100; attempt++) {
    const pos = randomPosition(map);
    
    // 检查地形是否合适
    if (!isValidTerrain(map, pos, wonder)) continue;
    
    // 检查与现有奇观的距离
    if (existing.some(e => distance(pos.row, pos.col, e.row, e.col) < MIN_DISTANCE)) continue;
    
    // 检查是否有足够空间放置多地块奇观
    if (!hasEnoughSpace(map, pos, wonder.tiles)) continue;
    
    return pos;
  }
  
  return null;
}
```

