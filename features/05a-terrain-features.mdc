## 四、河流系统

河流存在于地块边缘，而非地块本身。

### 河流效果

| 效果 | 说明 |
|-----|------|
| +1 宜居度 | 城市中心临河 |
| +2 金币邻接 | 商业中心临河 |
| 农场加成 | 封建主义后相邻农场+1粮食 |
| 移动惩罚 | 穿越河流消耗全部移动力 |
| 战斗惩罚 | 跨河攻击-3战斗力 |
| 允许水渠 | 城市可建造水渠连接河流 |

```typescript
interface RiverEdge {
  tileA: Coord;
  tileB: Coord;
  name?: string;  // 河流名称
}

interface RiverSystem {
  id: string;
  name: string;
  edges: RiverEdge[];
  source: Coord;  // 河流源头（山脉）
  mouth: Coord;   // 河流入海口
}

// 检查地块是否临河
function isAdjacentToRiver(position: Coord, rivers: RiverEdge[]): boolean {
  return rivers.some(edge =>
    (edge.tileA.row === position.row && edge.tileA.col === position.col) ||
    (edge.tileB.row === position.row && edge.tileB.col === position.col)
  );
}

// 检查两个地块之间是否有河流
function hasRiverBetween(a: Coord, b: Coord, rivers: RiverEdge[]): boolean {
  return rivers.some(edge =>
    (edge.tileA.row === a.row && edge.tileA.col === a.col &&
     edge.tileB.row === b.row && edge.tileB.col === b.col) ||
    (edge.tileA.row === b.row && edge.tileA.col === b.col &&
     edge.tileB.row === a.row && edge.tileB.col === a.col)
  );
}
```

