## 六、地块产出计算

```typescript
interface TileYields {
  food: number;
  production: number;
  gold: number;
  science: number;
  culture: number;
  faith: number;
}

function calculateTileYields(tile: Tile): TileYields {
  // 1. 基础地形产出
  const terrain = TERRAIN_DEFINITIONS[tile.terrain];
  let yields: TileYields = {
    food: terrain.yields.food,
    production: terrain.yields.production,
    gold: terrain.yields.gold,
    science: 0,
    culture: 0,
    faith: 0,
  };
  
  // 2. 高度修正（丘陵+1生产）
  if (tile.elevation === Elevation.HILLS) {
    yields.production += ELEVATION_DEFINITIONS[Elevation.HILLS].yieldModifier.production;
  }
  
  // 3. 地貌特征修正
  if (tile.feature) {
    const feature = FEATURE_DEFINITIONS[tile.feature];
    yields.food += feature.yieldModifier.food || 0;
    yields.production += feature.yieldModifier.production || 0;
    yields.gold += feature.yieldModifier.gold || 0;
    yields.science += feature.yieldModifier.science || 0;
    yields.culture += feature.yieldModifier.culture || 0;
    yields.faith += feature.yieldModifier.faith || 0;
  }
  
  // 4. 资源修正（见 05b-resources-biomes.mdc）
  if (tile.resource) {
    const resource = getResourceDefinition(tile.resource);
    yields = addYields(yields, resource.yields);
    
    // 改良设施加成
    if (tile.improvement === resource.requiredImprovement) {
      yields = addYields(yields, resource.improvedYields);
    }
  }
  
  // 5. 改良设施修正
  if (tile.improvement) {
    yields = addYields(yields, getImprovementYields(tile.improvement, tile));
  }
  
  return yields;
}
```

