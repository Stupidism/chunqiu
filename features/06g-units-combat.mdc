## 四、单位晋升系统

```typescript
interface Promotion {
  id: string;
  name: string;
  unitClasses: UnitClass[];  // 适用单位类型
  prerequisites: string[];    // 前置晋升
  effect: string;
  combatBonus?: CombatModifier;
  abilityGained?: string;
}

// 经验值需求
function getXPForPromotion(currentPromotions: number): number {
  // 第1次: 10 XP
  // 第2次: 25 XP
  // 第3次: 50 XP
  // 第4次: 85 XP
  // ...
  const xpTable = [10, 25, 50, 85, 130, 185, 250];
  return xpTable[Math.min(currentPromotions, xpTable.length - 1)];
}

// 战斗获得经验
function calculateXP(unit: Unit, target: Unit, damageDealt: number): number {
  // 基础经验 = 伤害 / 10
  let xp = Math.floor(damageDealt / 10);
  
  // 击杀额外经验
  if (target.damage >= target.maxHealth) {
    xp += 5;
  }
  
  // 对更强单位的额外经验
  if (target.combatStrength > unit.combatStrength) {
    xp += 2;
  }
  
  // 政策/建筑加成
  // 军营: +25%
  // 军械库: 额外 +25%
  // 军事学院: 额外 +25%
  
  return xp;
}

