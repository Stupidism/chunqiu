# 单位与战斗系统 (Units & Combat)

## 一、单位基础属性

```typescript
interface Unit {
  id: string;
  name: string;
  type: UnitType;
  class: UnitClass;
  era: Era;
  
  // 战斗属性
  combatStrength: number;      // 近战战斗力
  rangedStrength?: number;     // 远程战斗力（仅远程单位）
  bombardStrength?: number;    // 轰炸战斗力（仅攻城单位）
  range?: number;              // 攻击范围（远程单位）
  
  // 移动属性
  movement: number;            // 基础移动力
  sight: number;               // 视野范围
  
  // 生产属性
  productionCost: number;      // 生产力消耗
  goldCost: number;            // 金币购买成本
  maintenanceCost: number;     // 每回合维护费
  
  // 资源需求
  requiredResource?: string;   // 需要的战略资源
  resourceCost?: number;       // 消耗资源数量
  
  // 解锁条件
  unlockedBy: string;          // 解锁科技/市政
  upgradesTo?: string;         // 可升级为
  upgradeFrom?: string;        // 由...升级而来
  
  // 特殊能力
  abilities: string[];
}

enum UnitType {
  MELEE = 'melee',
  RANGED = 'ranged',
  CAVALRY = 'cavalry',
  SIEGE = 'siege',
  NAVAL = 'naval',
  SUPPORT = 'support',
  CIVILIAN = 'civilian',
  RELIGIOUS = 'religious',
}

enum UnitClass {
  // 陆军
  WARRIOR = 'warrior',         // 战士类
  ANTI_CAVALRY = 'anti_cavalry', // 抗骑兵
  LIGHT_CAVALRY = 'light_cavalry', // 轻骑兵
  HEAVY_CAVALRY = 'heavy_cavalry', // 重骑兵
  RANGED = 'ranged',           // 远程
  SIEGE = 'siege',             // 攻城
  RECON = 'recon',             // 侦察
  
  // 海军
  NAVAL_MELEE = 'naval_melee',
  NAVAL_RANGED = 'naval_ranged',
  NAVAL_RAIDER = 'naval_raider',
  NAVAL_CARRIER = 'naval_carrier',
  
  // 支援
  SUPPORT = 'support',
  
  // 平民
  CIVILIAN = 'civilian',
  RELIGIOUS = 'religious',
}
