## 三、战斗系统

### 战斗力计算

```typescript
interface CombatCalculation {
  baseCombatStrength: number;
  modifiers: CombatModifier[];
  finalStrength: number;
}

interface CombatModifier {
  source: string;      // 来源描述
  type: 'flat' | 'percentage';
  value: number;
}

function calculateEffectiveCombatStrength(
  unit: Unit,
  target: Unit | City,
  terrain: Terrain,
  context: CombatContext
): CombatCalculation {
  let strength = unit.combatStrength;
  const modifiers: CombatModifier[] = [];
  
  // 1. 地形修正
  if (context.attackerOnHill) {
    modifiers.push({ source: '高地优势', type: 'flat', value: 3 });
  }
  
  // 2. 河流穿越惩罚
  if (context.crossingRiver) {
    modifiers.push({ source: '穿越河流', type: 'flat', value: -3 });
  }
  
  // 3. 驻守加成
  if (unit.fortified) {
    const fortifyBonus = Math.min(unit.fortifyTurns * 3, 6);
    modifiers.push({ source: '驻守', type: 'flat', value: fortifyBonus });
  }
  
  // 4. 森林/丘陵防御
  if (context.isDefender && (terrain.feature === 'forest' || terrain.type === 'hills')) {
    modifiers.push({ source: '地形防御', type: 'flat', value: 3 });
  }
  
  // 5. 单位类型克制
  if (unit.class === UnitClass.ANTI_CAVALRY && target.class === UnitClass.LIGHT_CAVALRY) {
    modifiers.push({ source: '克制骑兵', type: 'flat', value: 10 });
  }
  
  // 6. 侧翼攻击
  if (context.flankingUnits > 0) {
    const flankBonus = context.flankingUnits * 2;
    modifiers.push({ source: `侧翼支援(×${context.flankingUnits})`, type: 'flat', value: flankBonus });
  }
  
  // 7. 支援攻击（相邻远程单位）
  if (context.supportingRanged > 0) {
    modifiers.push({ source: '远程支援', type: 'flat', value: context.supportingRanged * 2 });
  }
  
  // 8. 大将军加成
  if (context.hasGreatGeneral) {
    modifiers.push({ source: '大将军', type: 'flat', value: 5 });
  }
  
  // 9. 政策加成
  for (const policy of context.activePolicies) {
    const bonus = getPolicyCombatBonus(policy, unit, target);
    if (bonus) {
      modifiers.push(bonus);
    }
  }
  
  // 10. 晋升加成
  for (const promotion of unit.promotions) {
    const bonus = getPromotionCombatBonus(promotion, context);
    if (bonus) {
      modifiers.push(bonus);
    }
  }
  
  // 11. 受伤惩罚
  if (unit.damage > 0) {
    const healthPercent = (unit.maxHealth - unit.damage) / unit.maxHealth;
    const penalty = Math.floor((1 - healthPercent) * 10);
    modifiers.push({ source: '受伤', type: 'flat', value: -penalty });
  }
  
  // 计算最终战斗力
  let flatBonus = 0;
  let percentBonus = 1;
  
  for (const mod of modifiers) {
    if (mod.type === 'flat') {
      flatBonus += mod.value;
    } else {
      percentBonus *= (1 + mod.value / 100);
    }
  }
  
  const finalStrength = Math.floor((strength + flatBonus) * percentBonus);
  
  return {
    baseCombatStrength: strength,
    modifiers,
    finalStrength: Math.max(1, finalStrength), // 最低为1
  };
}
```

### 伤害计算公式

```typescript
interface CombatResult {
  attackerDamage: number;      // 攻击者受到的伤害
  defenderDamage: number;      // 防御者受到的伤害
  attackerKilled: boolean;
  defenderKilled: boolean;
  attackerXP: number;          // 攻击者获得经验
  defenderXP: number;          // 防御者获得经验
}

function calculateCombat(
  attacker: Unit,
  defender: Unit | City,
  context: CombatContext
): CombatResult {
  const attackerCalc = calculateEffectiveCombatStrength(attacker, defender, context.attackerTerrain, { ...context, isDefender: false });
  const defenderCalc = calculateEffectiveCombatStrength(defender, attacker, context.defenderTerrain, { ...context, isDefender: true });
  
  const attackerStrength = attackerCalc.finalStrength;
  const defenderStrength = defenderCalc.finalStrength;
  
  // 伤害公式: 30 × 1.041^(攻击者战斗力 - 防御者战斗力)
  // 这个公式使得每1点战斗力差距约等于4%的伤害差异
  const strengthDiff = attackerStrength - defenderStrength;
  const damageMultiplier = Math.pow(1.041, strengthDiff);
  
  // 基础伤害 30
  const baseDamage = 30;
  
  // 随机因子 (±10%)
  const randomFactor = 0.9 + Math.random() * 0.2;
  
  // 攻击者对防御者造成的伤害
  const defenderDamage = Math.round(baseDamage * damageMultiplier * randomFactor);
  
  // 防御者对攻击者造成的伤害（远程攻击时防御者不反击）
  let attackerDamage = 0;
  if (!attacker.rangedStrength || context.isMeleeAttack) {
    // 反击伤害 = 基础伤害 / 伤害倍率 × 随机因子
    attackerDamage = Math.round(baseDamage / damageMultiplier * randomFactor);
  }
  
  // 应用伤害
  const newAttackerDamage = Math.min(attacker.damage + attackerDamage, attacker.maxHealth);
  const newDefenderDamage = Math.min(defender.damage + defenderDamage, defender.maxHealth);
  
  // 经验值计算
  const attackerXP = calculateXP(attacker, defender, defenderDamage);
  const defenderXP = calculateXP(defender, attacker, attackerDamage);
  
  return {
    attackerDamage,
    defenderDamage,
    attackerKilled: newAttackerDamage >= attacker.maxHealth,
    defenderKilled: newDefenderDamage >= defender.maxHealth,
    attackerXP,
    defenderXP,
  };
}

// 伤害对照表（近似值）
// 战斗力差 | 造成伤害 | 受到伤害
// -10      | 20       | 45
// -5       | 24       | 37
// 0        | 30       | 30
// +5       | 37       | 24
// +10      | 45       | 20
// +15      | 55       | 16
// +20      | 67       | 13
```

### 战斗修正汇总表

| 修正类型 | 条件 | 效果 |
|---------|------|------|
| **地形修正** |
| 高地优势 | 攻击者在丘陵 | +3 |
| 河流穿越 | 跨河攻击 | -3 |
| 森林/丘陵防御 | 防御者在森林或丘陵 | +3 |
| **状态修正** |
| 驻守 | 每回合驻守+3，最高+6 | +3~+6 |
| 受伤 | 每10%生命损失 | -1 |
| **支援修正** |
| 侧翼攻击 | 每个相邻友军 | +2 |
| 远程支援 | 每个相邻远程单位 | +2 |
| 大将军 | 附近有大将军 | +5 |
| **克制关系** |
| 抗骑兵 vs 骑兵 | 矛兵/长矛兵 vs 骑兵类 | +10 |
| 攻城 vs 城墙 | 攻城单位 vs 防御工事 | +10~+17 |
| **政策/晋升** |
| 纪律政策 | vs 野蛮人 | +5 |
| 寡头政治 | 近战单位 | +4 |
| 各种晋升 | 条件各异 | +5~+10 |

