// 开拓者成本递增
function getSettlerCost(player: Player): number {
  const baseCost = 80;
  const citiesOwned = player.cities.length;
  
  // 每多一个城市，成本增加30%
  return Math.floor(baseCost * Math.pow(1.3, citiesOwned));
}
