## 四、邻接加成计算代码

```typescript
interface AdjacencyBonus {
  districtType: string;
  yieldType: 'science' | 'culture' | 'gold' | 'production' | 'faith';
  amount: number;
}

function calculateDistrictAdjacency(
  district: District,
  position: Coord,
  map: GameMap
): AdjacencyBonus {
  const rules = district.adjacencyRules;
  const neighbors = getNeighbors(position.row, position.col, map.width, map.height);
  
  let totalBonus = 0;
  const typeCounts: Record<string, number> = {};
  
  for (const neighborPos of neighbors) {
    const tile = map.getTile(neighborPos);
    
    for (const rule of rules) {
      let matches = false;
      
      switch (rule.type) {
        case 'terrain':
          matches = tile.terrain === rule.target;
          break;
        case 'feature':
          matches = tile.feature === rule.target;
          break;
        case 'resource':
          matches = tile.resource?.type === rule.target;
          break;
        case 'district':
          matches = tile.district !== null && 
                    (rule.target === 'any' || tile.district.type === rule.target);
          break;
        case 'improvement':
          matches = tile.improvement === rule.target;
          break;
        case 'river':
          // 特殊处理：检查整个区域是否相邻河流
          matches = isAdjacentToRiver(position, map);
          break;
      }
      
      if (matches) {
        const key = `${rule.type}_${rule.target}`;
        typeCounts[key] = (typeCounts[key] || 0) + 1;
        
        if (rule.divisor) {
          // 每N个+X的规则
          if (typeCounts[key] % rule.divisor === 0) {
            totalBonus += rule.bonus;
          }
        } else {
          totalBonus += rule.bonus;
        }
      }
    }
  }
  
  return {
    districtType: district.id,
    yieldType: district.yieldType,
    amount: Math.floor(totalBonus), // 向下取整
  };
}

// 政策对邻接加成的倍率
function applyAdjacencyPolicy(bonus: number, districtType: string, policies: string[]): number {
  let multiplier = 1;
  
  // 自然哲学：学院邻接+100%
  if (districtType === 'campus' && policies.includes('natural_philosophy')) {
    multiplier = 2;
  }
  
  // 大教堂：剧院广场邻接+100%
  if (districtType === 'theater_square' && policies.includes('grand_opera')) {
    multiplier = 2;
  }
  
  // 工业规划：工业区邻接+100%
  if (districtType === 'industrial_zone' && policies.includes('industrial_planning')) {
    multiplier = 2;
  }
  
  return bonus * multiplier;
}
```

