## 三、贸易路线

### 贸易路线机制

```typescript
interface TradeRoute {
  id: string;
  origin: City;           // 起点城市
  destination: City;      // 终点城市
  type: 'domestic' | 'international';
  trader: Unit;           // 商人单位
  
  // 产出
  yields: {
    food: number;
    production: number;
    gold: number;
    science: number;
    culture: number;
    faith: number;
  };
  
  // 路线信息
  path: Coord[];          // 路径
  turnsRemaining: number; // 剩余回合
  totalTurns: number;     // 总回合数
}

// 贸易路线容量
function getTradeRouteCapacity(player: Player): number {
  let capacity = 0;
  
  // 商业中心+1
  for (const city of player.cities) {
    if (city.hasDistrict('commercial_hub')) {
      capacity++;
    }
    // 港口+1
    if (city.hasDistrict('harbor')) {
      capacity++;
    }
  }
  
  // 政府加成
  if (player.government === 'merchant_republic') {
    capacity += 2;
  }
  
  // 奇观加成
  if (player.hasWonder('colossus')) {
    capacity++;
  }
  if (player.hasWonder('great_zimbabwe')) {
    capacity++;
  }
  
  return capacity;
}
```

### 贸易收益计算

```typescript
function calculateTradeYields(
  origin: City,
  destination: City,
  player: Player
): TradeRoute['yields'] {
  const yields = {
    food: 0,
    production: 0,
    gold: 0,
    science: 0,
    culture: 0,
    faith: 0,
  };
  
  const isDomestic = origin.owner === destination.owner;
  
  if (isDomestic) {
    // 国内贸易
    // 基础: +1粮食 +1生产力
    yields.food = 1;
    yields.production = 1;
    
    // 政策加成
    if (player.policies.includes('caravansaries')) {
      yields.food++;
      yields.production++;
    }
    
    // 目的地区域加成
    if (destination.hasDistrict('commercial_hub')) {
      yields.gold += 1;
    }
    if (destination.hasDistrict('harbor')) {
      yields.gold += 1;
    }
    if (destination.hasDistrict('campus')) {
      yields.science += 1;
    }
    if (destination.hasDistrict('holy_site')) {
      yields.faith += 1;
    }
    if (destination.hasDistrict('theater_square')) {
      yields.culture += 1;
    }
    if (destination.hasDistrict('industrial_zone')) {
      yields.production += 1;
    }
    
  } else {
    // 国际贸易
    // 基础: +3金币
    yields.gold = 3;
    
    // 目的地区域加成（更高）
    if (destination.hasDistrict('commercial_hub')) {
      yields.gold += 2;
    }
    if (destination.hasDistrict('harbor')) {
      yields.gold += 2;
    }
    if (destination.hasDistrict('campus')) {
      yields.science += 1;
    }
    if (destination.hasDistrict('holy_site')) {
      yields.faith += 1;
    }
    if (destination.hasDistrict('theater_square')) {
      yields.culture += 1;
    }
    if (destination.hasDistrict('industrial_zone')) {
      yields.production += 1;
    }
    
    // 目的地资源加成
    const destinationLuxuries = destination.getLuxuryResources();
    yields.gold += destinationLuxuries.length;
    
    // 奇观加成
    if (player.hasWonder('great_zimbabwe')) {
      yields.gold += destination.getBonusResources().length;
    }
  }
  
  // 政府加成
  if (player.government === 'merchant_republic') {
    yields.gold += 2;
  }
  
  return yields;
}
```

### 商人单位

```typescript
const TRADER: Unit = {
  id: 'trader',
  name: '商人',
  type: UnitType.CIVILIAN,
  class: UnitClass.CIVILIAN,
  era: 'ancient',
  combatStrength: 0,
  movement: 2,
  sight: 2,
  productionCost: 40,
  goldCost: 160,
  maintenanceCost: 0,
  unlockedBy: 'foreign_trade', // 对外贸易市政
  abilities: ['establish_trade_route'],
};

// 建立贸易路线
function establishTradeRoute(
  trader: Unit,
  destination: City,
  player: Player
): TradeRoute | null {
  const origin = getClosestCity(trader.position, player);
  
  // 验证
  if (!origin) return null;
  if (origin === destination) return null;
  
  // 检查容量
  if (player.tradeRoutes.length >= getTradeRouteCapacity(player)) {
    return null;
  }
  
  // 计算路径和回合数
  const path = findTradePath(origin.position, destination.position);
  const totalTurns = calculateTradeDuration(path.length);
  
  const route: TradeRoute = {
    id: generateId(),
    origin,
    destination,
    type: origin.owner === destination.owner ? 'domestic' : 'international',
    trader,
    yields: calculateTradeYields(origin, destination, player),
    path,
    turnsRemaining: totalTurns,
    totalTurns,
  };
  
  player.tradeRoutes.push(route);
  
  return route;
}

// 贸易路线持续时间
function calculateTradeDuration(pathLength: number): number {
  // 基础: 20回合
  // 距离修正: 每5格+1回合
  return 20 + Math.floor(pathLength / 5);
}
```

