### 使者系统

```typescript
// 使者来源
interface EnvoySource {
  type: 'influence' | 'civic' | 'policy' | 'great_person' | 'wonder';
  amount: number;
}

// 外交影响力
function calculateInfluencePerTurn(player: Player): number {
  let influence = 0;
  
  // 政府类型
  if (player.government === 'monarchy') {
    influence += 3;
  }
  
  // 总督
  for (const governor of player.governors) {
    if (governor.title === 'Amani' && governor.established) {
      influence += 2;
    }
  }
  
  // 政策
  if (player.policies.includes('charismatic_leader')) {
    influence += 2;
  }
  
  return influence;
}

// 累积100外交影响力获得1使者
function processInfluence(player: Player): void {
  player.influence += calculateInfluencePerTurn(player);
  
  while (player.influence >= 100) {
    player.influence -= 100;
    player.availableEnvoys++;
    
    sendNotification(player, {
      type: 'ENVOY_EARNED',
      message: '获得1名使者可派遣到城邦',
    });
  }
}

// 派遣使者
function sendEnvoy(player: Player, cityState: CityState): boolean {
  if (player.availableEnvoys <= 0) return false;
  
  player.availableEnvoys--;
  cityState.envoys[player.id] = (cityState.envoys[player.id] || 0) + 1;
  
  // 检查宗主国变化
  updateSuzerain(cityState);
  
  return true;
}

// 更新宗主国
function updateSuzerain(cityState: CityState): void {
  let maxEnvoys = 0;
  let newSuzerain: string | null = null;
  
  for (const [playerId, envoys] of Object.entries(cityState.envoys)) {
    if (envoys >= 3 && envoys > maxEnvoys) {
      maxEnvoys = envoys;
      newSuzerain = playerId;
    }
  }
  
  // 必须比第二名多至少1个使者
  const sortedEnvoys = Object.values(cityState.envoys).sort((a, b) => b - a);
  if (sortedEnvoys.length >= 2 && sortedEnvoys[0] <= sortedEnvoys[1]) {
    newSuzerain = null;
  }
  
  if (cityState.suzerain !== newSuzerain) {
    const oldSuzerain = cityState.suzerain;
    cityState.suzerain = newSuzerain;
    
    // 通知
    if (newSuzerain) {
      sendNotification(getPlayer(newSuzerain), {
        type: 'SUZERAIN_GAINED',
        cityState: cityState.name,
      });
    }
    if (oldSuzerain) {
      sendNotification(getPlayer(oldSuzerain), {
        type: 'SUZERAIN_LOST',
        cityState: cityState.name,
      });
    }
  }
}
```

### 城邦进贡

```typescript
// 宗主国可以征收城邦贡金
interface TributeOptions {
  gold: number;      // 一次性金币
  resources: string[]; // 战略/奢侈资源
}

function demandTribute(player: Player, cityState: CityState): TributeOptions | null {
  if (cityState.suzerain !== player.id) {
    return null;
  }
  
  // 计算可获得的贡金
  const gold = 50 + cityState.envoys[player.id] * 10;
  const resources = cityState.ownedResources.filter(r => 
    !player.hasResource(r)
  );
  
  return {
    gold,
    resources: resources.slice(0, 1), // 最多1种资源
  };
}
```

