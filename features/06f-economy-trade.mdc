## 二、金币购买

### 购买成本计算

```typescript
interface PurchaseCost {
  type: 'unit' | 'building' | 'tile';
  id: string;
  goldCost: number;
  faithCost?: number; // 如果支持信仰购买
}

function calculatePurchaseCost(
  type: 'unit' | 'building',
  id: string,
  city: City,
  player: Player
): PurchaseCost {
  let productionCost: number;
  
  if (type === 'unit') {
    productionCost = getUnitProductionCost(id);
  } else {
    productionCost = getBuildingProductionCost(id);
  }
  
  // 基础金币成本 = 生产力 × 4
  let goldCost = productionCost * 4;
  
  // 政府加成
  if (player.government === 'democracy') {
    goldCost *= 0.85; // 民主制项目生产+15%
  }
  
  // 政策加成
  if (player.policies.includes('mercantilism')) {
    goldCost *= 0.85; // 重商主义-15%购买成本
  }
  
  return {
    type,
    id,
    goldCost: Math.floor(goldCost),
  };
}

// 地块购买成本
function calculateTilePurchaseCost(city: City, tile: Tile): number {
  // 基础成本 = 50 + 已购买地块数 × 20
  const tilesOwned = city.purchasedTiles.length;
  let cost = 50 + tilesOwned * 20;
  
  // 距离修正
  const distance = getDistance(city.position, tile.position);
  cost += (distance - 1) * 10;
  
  // 资源加成
  if (tile.resource) {
    cost += 20;
  }
  
  return cost;
}
```

### 单位升级

```typescript
interface UpgradeCost {
  fromUnit: string;
  toUnit: string;
  goldCost: number;
  resourceCost?: { resource: string; amount: number };
}

function calculateUpgradeCost(unit: Unit, toType: string, player: Player): UpgradeCost {
  const fromCost = getUnitProductionCost(unit.type);
  const toCost = getUnitProductionCost(toType);
  
  // 基础升级成本 = (新单位成本 - 旧单位成本) × 3
  let goldCost = (toCost - fromCost) * 3;
  
  // 最低成本
  goldCost = Math.max(goldCost, 25);
  
  // 政策加成
  if (player.policies.includes('professional_army')) {
    goldCost *= 0.5; // 职业军队-50%升级成本
  }
  if (player.policies.includes('conscription')) {
    goldCost *= 0.5; // 征兵-50%升级成本
  }
  
  // 资源需求
  const toUnitDef = getUnitDefinition(toType);
  let resourceCost;
  if (toUnitDef.requiredResource) {
    resourceCost = {
      resource: toUnitDef.requiredResource,
      amount: toUnitDef.resourceCost || 1,
    };
  }
  
  return {
    fromUnit: unit.type,
    toUnit: toType,
    goldCost: Math.floor(goldCost),
    resourceCost,
  };
}
```

