## 五、外交交易

### 交易类型

```typescript
interface DiplomaticDeal {
  id: string;
  proposer: string;
  receiver: string;
  status: 'proposed' | 'accepted' | 'rejected' | 'active' | 'expired';
  
  // 提议方给予
  giving: DealTerms;
  // 提议方获得
  receiving: DealTerms;
  
  // 持续时间
  duration: number;        // 回合数，0表示一次性
  turnsRemaining: number;
}

interface DealTerms {
  gold?: number;           // 一次性金币
  goldPerTurn?: number;    // 每回合金币
  resources?: {
    type: string;
    amount: number;
    duration: number;
  }[];
  cities?: string[];       // 割让城市
  openBorders?: boolean;   // 开放边境
  alliance?: boolean;      // 同盟
  peace?: boolean;         // 和平条约
  jointWar?: string;       // 联合宣战目标
  delegation?: boolean;    // 代表团
  embassy?: boolean;       // 大使馆
}

// 交易价值估算（用于AI判断）
function evaluateDealValue(terms: DealTerms, player: Player): number {
  let value = 0;
  
  if (terms.gold) value += terms.gold;
  if (terms.goldPerTurn) value += terms.goldPerTurn * 10; // 假设10回合
  
  for (const resource of terms.resources || []) {
    if (resource.type === 'luxury') {
      value += 50 * resource.amount;
    } else if (resource.type === 'strategic') {
      value += 30 * resource.amount;
    }
  }
  
  if (terms.cities) {
    for (const cityId of terms.cities) {
      const city = getCity(cityId);
      value += city.population * 100 + city.districts.length * 50;
    }
  }
  
  if (terms.openBorders) value += 25;
  if (terms.delegation) value += 25;
  if (terms.embassy) value += 50;
  
  return value;
}
```

### 资源交易

```typescript
// 奢侈资源效果
// 每种奢侈资源为前4个城市各提供+1宜居度
// 重复的奢侈资源只能用于交易

// 战略资源效果
// 用于生产需要该资源的单位
// 每个战略资源有库存上限

interface ResourceInventory {
  resource: string;
  amount: number;          // 当前库存
  perTurn: number;         // 每回合获取
  maxStorage: number;      // 最大库存
}

function calculateResourceIncome(player: Player): Record<string, number> {
  const income: Record<string, number> = {};
  
  for (const city of player.cities) {
    for (const tile of city.workedTiles) {
      if (tile.resource && tile.improved) {
        income[tile.resource] = (income[tile.resource] || 0) + 1;
      }
    }
  }
  
  return income;
}
