function calculateGoldExpenses(player: Player): GoldExpenses {
  const expenses: GoldExpenses = {
    unitMaintenance: 0,
    buildingMaintenance: 0,
    deals: 0,
    policies: 0,
  };
  
  // 单位维护
  for (const unit of player.units) {
    const baseMaintenance = UNIT_MAINTENANCE[unit.type] || 0;
    let maintenance = baseMaintenance;
    
    // 政府加成
    if (player.government === 'communism') {
      maintenance *= 0.75; // 共产主义陆军维护-25%
    }
    
    expenses.unitMaintenance += maintenance;
  }
  
  // 建筑维护
  for (const city of player.cities) {
    for (const building of city.buildings) {
      expenses.buildingMaintenance += BUILDING_MAINTENANCE[building] || 0;
    }
  }
  
  // 外交支付
  for (const deal of player.activeDeals) {
    if (deal.giving.gold) {
      expenses.deals += deal.giving.goldPerTurn;
    }
  }
  
  return expenses;
}
```

### 金币平衡

```typescript
interface GoldBalance {
  income: GoldIncome;
  expenses: GoldExpenses;
  totalIncome: number;
  totalExpenses: number;
  netIncome: number;
  treasury: number;
}

function calculateGoldBalance(player: Player): GoldBalance {
  const income = calculateGoldIncome(player);
  const expenses = calculateGoldExpenses(player);
  
  const totalIncome = Object.values(income).reduce((a, b) => a + b, 0);
  const totalExpenses = Object.values(expenses).reduce((a, b) => a + b, 0);
  
  return {
    income,
    expenses,
    totalIncome,
    totalExpenses,
    netIncome: totalIncome - totalExpenses,
    treasury: player.treasury,
  };
}

// 破产处理
function handleBankruptcy(player: Player): void {
  if (player.treasury < 0) {
    // 随机解散一个单位
    const disbandableUnits = player.units.filter(u => 
      u.type !== 'settler' && 
      UNIT_MAINTENANCE[u.type] > 0
    );
    
    if (disbandableUnits.length > 0) {
      const unitToDisband = disbandableUnits[Math.floor(Math.random() * disbandableUnits.length)];
      removeUnit(unitToDisband);
      
      // 通知玩家
      sendNotification(player, {
        type: 'UNIT_DISBANDED',
        message: `由于国库为负，${unitToDisband.name} 被解散`,
        unitId: unitToDisband.id,
      });
    }
  }
}
```

