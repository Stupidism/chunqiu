# 经济与贸易系统 (Economy & Trade)

## 概述

经济系统管理文明的金币收支、贸易路线、城邦外交等。金币是游戏中最灵活的资源，可以用于购买单位、建筑、升级、外交交易等。

---

## 一、金币收支

### 收入来源

```typescript
interface GoldIncome {
  tiles: number;           // 地块产出
  buildings: number;       // 建筑产出
  districtAdjacency: number; // 区域邻接
  tradeRoutes: number;     // 贸易路线
  cityStates: number;      // 城邦进贡
  deals: number;           // 外交交易
  pillage: number;         // 劫掠所得
  greatPeople: number;     // 伟人能力
}

function calculateGoldIncome(player: Player): GoldIncome {
  const income: GoldIncome = {
    tiles: 0,
    buildings: 0,
    districtAdjacency: 0,
    tradeRoutes: 0,
    cityStates: 0,
    deals: 0,
    pillage: 0,
    greatPeople: 0,
  };
  
  // 1. 地块产出
  for (const city of player.cities) {
    for (const tile of city.workedTiles) {
      income.tiles += getTileYields(tile).gold;
    }
  }
  
  // 2. 建筑产出
  for (const city of player.cities) {
    for (const building of city.buildings) {
      income.buildings += getBuildingYields(building).gold;
    }
  }
  
  // 3. 区域邻接
  for (const city of player.cities) {
    const commercialHub = city.getDistrict('commercial_hub');
    if (commercialHub) {
      income.districtAdjacency += commercialHub.adjacencyBonus;
    }
    const harbor = city.getDistrict('harbor');
    if (harbor) {
      income.districtAdjacency += harbor.adjacencyBonus;
    }
  }
  
  // 4. 贸易路线
  for (const route of player.tradeRoutes) {
    income.tradeRoutes += route.yields.gold;
  }
  
  // 5. 城邦进贡
  for (const cityState of player.suzerainCityStates) {
    income.cityStates += getCityStateGoldBonus(cityState, player);
  }
  
  // 6. 外交交易
  for (const deal of player.activeDeals) {
    if (deal.receiving.gold) {
      income.deals += deal.receiving.goldPerTurn;
    }
  }
  
  return income;
}
```

