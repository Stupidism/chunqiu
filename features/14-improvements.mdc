## 八、改良设施产出计算

```typescript
function calculateImprovementYields(tile: Tile, player: Player): Yields {
  if (!tile.improvement || tile.pillaged) {
    return {};
  }
  
  const improvement = getImprovement(tile.improvement);
  let yields = { ...improvement.baseYields };
  
  // 科技/市政加成
  for (const bonus of improvement.bonusYields || []) {
    if (player.hasTech(bonus.unlockedBy) || player.hasCivic(bonus.unlockedBy)) {
      yields = addYields(yields, bonus.yields);
    }
  }
  
  // 邻接加成
  if (improvement.adjacencyBonus) {
    const neighbors = getNeighbors(tile.position);
    for (const adj of improvement.adjacencyBonus) {
      const count = neighbors.filter(n => {
        const neighborTile = getTile(n);
        return neighborTile.improvement === adj.adjacent;
      }).length;
      
      if (count > 0) {
        yields = addYields(yields, multiplyYields(adj.yields, count));
      }
    }
  }
  
  // 资源加成（如果有资源且已改良）
  if (tile.resource) {
    const resource = getResource(tile.resource);
    if (resource.improvement === improvement.id) {
      yields = addYields(yields, resource.improvedYields);
    }
  }
  
  return yields;
}
```
