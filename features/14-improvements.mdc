# 改良设施系统 (Improvements)

## 概述

改良设施由工人单位建造在地块上，用于开发资源、增加产出或提供特殊效果。改良设施可被敌人劫掠，劫掠后需要工人修复。

---

## 一、改良设施数据结构

```typescript
interface Improvement {
  id: string;
  name: string;
  
  // 建造条件
  unlockedBy: string;           // 解锁科技/市政
  buildTime: number;            // 建造回合（工人次数消耗通常为1）
  
  // 位置要求
  validTerrains: TerrainType[];
  validFeatures: FeatureType[];
  validElevations: Elevation[];
  requiredResource?: string[];   // 必须有指定资源
  requiresAdjacentResource?: string; // 必须相邻指定资源
  coastal?: boolean;             // 必须沿海
  river?: boolean;               // 必须临河
  
  // 产出
  baseYields: Yields;
  bonusYields?: BonusYield[];    // 科技/市政解锁的额外产出
  adjacencyBonus?: AdjacencyBonus[]; // 邻接加成
  
  // 效果
  removesFeature?: FeatureType[]; // 会移除哪些地貌
  providesHousing?: number;
  providesDefense?: number;
  
  // 其他
  pillageYield?: { type: string; amount: number }; // 被劫掠时敌人获得
  cannotBePillaged?: boolean;
  obsoleteBy?: string;           // 被淘汰的科技
  replacedBy?: string;           // 升级为
}

interface BonusYield {
  unlockedBy: string;           // 科技或市政
  yields: Yields;
}

interface AdjacencyBonus {
  adjacent: string;             // 相邻什么
  yields: Yields;
}
```

