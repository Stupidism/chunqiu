## 七、改良设施建造与劫掠

```typescript
// 工人建造改良设施
function buildImprovement(
  worker: Unit,
  improvement: Improvement,
  tile: Tile
): boolean {
  // 验证建造条件
  if (!canBuildImprovement(worker, improvement, tile)) {
    return false;
  }
  
  // 消耗建造次数
  worker.buildCharges--;
  
  // 移除冲突地貌
  if (improvement.removesFeature && tile.feature) {
    if (improvement.removesFeature.includes(tile.feature)) {
      // 砍伐森林/雨林获得一次性产出
      if (tile.feature === FeatureType.WOODS) {
        addYieldToCity(tile.city!, { production: 50 });
      } else if (tile.feature === FeatureType.RAINFOREST) {
        addYieldToCity(tile.city!, { production: 30 });
      }
      tile.feature = null;
    }
  }
  
  // 建造改良
  tile.improvement = improvement.id;
  tile.pillaged = false;
  
  // 检查工人是否用完建造次数
  if (worker.buildCharges <= 0) {
    removeUnit(worker);
  }
  
  return true;
}

// 劫掠改良设施
function pillageImprovement(unit: Unit, tile: Tile): PillageResult {
  if (!tile.improvement || tile.pillaged) {
    return { success: false };
  }
  
  const improvement = getImprovement(tile.improvement);
  
  // 标记为劫掠状态
  tile.pillaged = true;
  
  // 劫掠收益
  const reward = improvement.pillageYield;
  
  if (reward) {
    if (reward.type === 'gold') {
      unit.owner.treasury += reward.amount;
    } else if (reward.type === 'healing') {
      unit.damage = Math.max(0, unit.damage - reward.amount);
    }
  }
  
  // 消耗移动力
  unit.movementRemaining = 0;
  
  return { success: true, reward };
}

// 修复劫掠的改良设施
function repairImprovement(worker: Unit, tile: Tile): boolean {
  if (!tile.pillaged) return false;
  
  tile.pillaged = false;
  worker.buildCharges--;
  
  if (worker.buildCharges <= 0) {
    removeUnit(worker);
  }
  
  return true;
}
```

