## 五、道路系统

道路是连接城市的特殊改良，减少移动消耗。

### 道路类型

| 类型 | 解锁 | 移动消耗 | 特点 |
|-----|------|---------|------|
| **古代道路** | 轮子 | 1移动力=2格 | 自动由商人创建 |
| **工业道路** | 蒸汽动力 | 1移动力=3格 | 可建造桥梁跨河 |
| **现代道路** | 内燃机 | 1移动力=4格 | - |

```typescript
enum RoadLevel {
  NONE = 0,
  ANCIENT_ROAD = 1,
  INDUSTRIAL_ROAD = 2,
  MODERN_ROAD = 3,
}

const ROAD_DEFINITIONS: Record<RoadLevel, { movementBonus: number; crossRiver: boolean }> = {
  [RoadLevel.NONE]: { movementBonus: 1, crossRiver: false },
  [RoadLevel.ANCIENT_ROAD]: { movementBonus: 0.5, crossRiver: false },
  [RoadLevel.INDUSTRIAL_ROAD]: { movementBonus: 0.33, crossRiver: true },
  [RoadLevel.MODERN_ROAD]: { movementBonus: 0.25, crossRiver: true },
};

// 商人自动铺设道路
function onTradeRouteComplete(route: TradeRoute): void {
  const roadLevel = getRoadLevelForEra(route.origin.owner.era);
  
  for (const tile of route.path) {
    if (tile.road < roadLevel) {
      tile.road = roadLevel;
    }
  }
}
```

