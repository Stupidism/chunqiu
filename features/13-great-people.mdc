# 伟人系统 (Great People)

## 概述

伟人是历史上杰出的人物，可通过累积伟人点数招募。每位伟人都有独特的能力，使用后永久退休。伟人按类型和时代分组，每个时代有多位伟人供所有文明竞争。

---

## 一、伟人数据结构

```typescript
interface GreatPerson {
  id: string;
  name: string;
  type: GreatPersonType;
  era: Era;
  
  // 招募成本
  recruitCost: {
    points: number;     // 伟人点数
    faith?: number;     // 或用信仰购买
    gold?: number;      // 或用金币购买
  };
  
  // 能力
  abilities: GreatPersonAbility[];
  passiveBonus?: PassiveBonus;  // 被动加成（某些伟人）
  
  // 展示
  quote: string;
  historicalInfo: string;
  portrait: string;
}

enum GreatPersonType {
  GREAT_GENERAL = 'great_general',       // 大将军
  GREAT_ADMIRAL = 'great_admiral',       // 大海军提督
  GREAT_SCIENTIST = 'great_scientist',   // 大科学家
  GREAT_ENGINEER = 'great_engineer',     // 大工程师
  GREAT_MERCHANT = 'great_merchant',     // 大商人
  GREAT_PROPHET = 'great_prophet',       // 大预言家
  GREAT_WRITER = 'great_writer',         // 大作家
  GREAT_ARTIST = 'great_artist',         // 大艺术家
  GREAT_MUSICIAN = 'great_musician',     // 大音乐家
}

interface GreatPersonAbility {
  type: AbilityType;
  description: string;
  uses: number;          // 可使用次数（通常为1）
  target: AbilityTarget; // 目标类型
  effect: any;
}

enum AbilityTarget {
  SELF = 'self',           // 伟人自身位置
  CITY = 'city',           // 城市
  DISTRICT = 'district',   // 区域
  TILE = 'tile',           // 地块
  UNIT = 'unit',           // 单位
  WONDER = 'wonder',       // 奇观
}
```

