## 九、伟人招募机制

```typescript
interface GreatPersonPool {
  type: GreatPersonType;
  currentPerson: GreatPerson;           // 当前可招募的伟人
  nextPersons: GreatPerson[];           // 下一批伟人
  patronageCosts: Record<PlayerId, number>; // 各玩家累积的点数
}

// 伟人竞争
function processGreatPersonRecruitment(pool: GreatPersonPool, game: Game): void {
  const current = pool.currentPerson;
  
  for (const player of game.players) {
    const points = pool.patronageCosts[player.id] || 0;
    
    // 检查是否达到招募成本
    if (points >= current.recruitCost.points) {
      // 招募伟人
      recruitGreatPerson(player, current);
      
      // 重置点数
      pool.patronageCosts[player.id] = 0;
      
      // 推进到下一位伟人
      pool.currentPerson = pool.nextPersons.shift()!;
      
      // 通知所有玩家
      broadcastGreatPersonRecruited(player, current);
      
      return;
    }
  }
}

// 金币/信仰购买
function purchaseGreatPerson(
  player: Player,
  person: GreatPerson,
  currency: 'gold' | 'faith'
): boolean {
  const cost = currency === 'gold' 
    ? person.recruitCost.gold 
    : person.recruitCost.faith;
    
  if (!cost) return false;
  
  // 检查是否有足够货币
  if (player[currency] < cost) return false;
  
  // 扣除货币
  player[currency] -= cost;
  
  // 招募伟人
  recruitGreatPerson(player, person);
  
  return true;
}

// 使用伟人能力
function activateGreatPerson(
  person: GreatPersonUnit,
  ability: GreatPersonAbility,
  target: any
): boolean {
  // 验证使用次数
  if (person.usedAbilities.includes(ability.type)) {
    return false;
  }
  
  // 执行能力效果
  executeAbilityEffect(ability, person, target);
  
  // 记录使用
  person.usedAbilities.push(ability.type);
  
  // 如果所有能力都已使用，伟人退休
  if (person.usedAbilities.length >= person.abilities.length) {
    retireGreatPerson(person);
  }
  
  return true;
}
```
