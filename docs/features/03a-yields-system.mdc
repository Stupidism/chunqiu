## 二、产出计算总公式

```typescript
interface CityYields {
  food: number;
  production: number;
  gold: number;
  science: number;
  culture: number;
  faith: number;
}

function calculateCityYields(city: City, player: Player): CityYields {
  // 1. 城市中心基础产出
  let yields: CityYields = {
    food: 2,       // 城市中心固定 +2 粮食
    production: 1, // 城市中心固定 +1 生产力
    gold: 0,
    science: 0,
    culture: 0,
    faith: 0,
  };
  
  // 2. 工作地块产出
  for (const tile of city.workedTiles) {
    const tileYields = calculateTileYields(tile);
    yields = addYields(yields, tileYields);
  }
  
  // 3. 建筑产出
  for (const building of city.buildings) {
    const buildingYields = getBuildingYields(building);
    yields = addYields(yields, buildingYields);
  }
  
  // 4. 区域邻接加成
  for (const district of city.districts) {
    const adjacencyBonus = calculateDistrictAdjacency(district, city.position);
    yields = addYields(yields, adjacencyBonus);
  }
  
  // 5. 宗教信条加成
  if (city.religion) {
    const beliefYields = calculateBeliefYields(city, city.religion);
    yields = addYields(yields, beliefYields);
  }
  
  // 6. 贸易路线产出
  for (const route of city.outgoingTradeRoutes) {
    yields = addYields(yields, route.yields);
  }
  
  // 7. 伟人加成
  for (const greatPerson of city.stationedGreatPeople) {
    yields = addYields(yields, greatPerson.passiveYields);
  }
  
  // 8. 政策百分比加成 (最后应用)
  yields = applyPolicyModifiers(yields, player.policies);
  
  // 9. 政府固有加成
  yields = applyGovernmentBonus(yields, player.government, city);
  
  return yields;
}
```

