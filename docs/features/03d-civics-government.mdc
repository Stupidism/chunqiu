## 五、政策切换

```typescript
interface PolicyChangeContext {
  civicJustCompleted: boolean;  // 市政刚完成
  governmentChanged: boolean;   // 政府刚更换
  era: Era;
}

function getPolicyChangeCost(player: Player, context: PolicyChangeContext): number {
  // 市政完成或政府更换时免费
  if (context.civicJustCompleted || context.governmentChanged) {
    return 0;
  }
  
  // 否则按时代收费
  const eraCost: Record<Era, number> = {
    ancient: 50,
    classical: 100,
    medieval: 150,
    renaissance: 200,
    industrial: 250,
    modern: 300,
    atomic: 350,
    information: 400,
  };
  
  return eraCost[context.era];
}
```

