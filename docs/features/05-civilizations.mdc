## 文明数据结构

```typescript
interface Civilization {
  id: string;
  name: string;
  adjective: string;           // 形容词（如"秦"→"秦国的"）
  icon: string;                // 国旗/图腾（甲骨文字符）
  colors: {
    primary: string;           // 主色
    secondary: string;         // 辅色
  };
  
  // 领袖
  leader: Leader;
  
  // 文明特性
  civilizationAbility: Ability;
  
  // 特色内容
  uniqueUnits: UniqueUnit[];
  uniqueBuildings: UniqueBuilding[];
  uniqueImprovements: UniqueImprovement[];
  uniqueDistricts: UniqueDistrict[];
  
  // 起始偏好
  startBias: StartBias;
  
  // 历史背景
  historicalInfo: HistoricalInfo;
}

interface Leader {
  id: string;
  name: string;
  title: string;               // 头衔
  era: string;                 // 在位时期
  ability: Ability;            // 领袖能力
  agenda: Agenda;              // AI行为倾向
  quotes: string[];            // 名言
  biography: string;           // 生平简介
}

interface Ability {
  name: string;
  description: string;
  detailedDescription: string; // 详细机制说明
  effects: AbilityEffect[];
}

interface HistoricalInfo {
  founding: string;            // 建国历史
  territory: string;           // 疆域描述
  culture: string;             // 文化特色
  legacy: string;              // 历史遗产
  famousFigures: string[];     // 著名人物
}

interface StartBias {
  terrain?: TerrainType[];     // 偏好地形
  feature?: FeatureType[];     // 偏好地貌
  resource?: string[];         // 偏好资源
  coastal?: boolean;           // 偏好沿海
  river?: boolean;             // 偏好河流
  tier: 1 | 2 | 3 | 4 | 5;    // 偏好强度（5最强）
}
```

