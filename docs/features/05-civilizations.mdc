## AI 议程系统

```typescript
interface Agenda {
  name: string;
  likes: string;      // 喜欢什么样的文明
  dislikes: string;   // 讨厌什么样的文明
  weight: number;     // 影响外交的权重 (1-10)
}

// AI根据议程评估外交关系
function evaluateDiplomacy(ai: Player, target: Player): number {
  let score = 0;
  const agenda = ai.civilization.leader.agenda;
  
  // 根据议程评估
  switch (agenda.name) {
    case '霸主雄心': // 秦穆公
      score += target.militaryStrength > ai.militaryStrength ? 10 : -10;
      break;
    case '霸主外交': // 齐桓公
      score += target.cityStateRelations > 0 ? 10 : 0;
      score -= target.hasConqueredCityState ? 20 : 0;
      break;
    case '南方霸主': // 楚庄王
      score += target.cities.length > 5 ? 10 : -5;
      break;
    // ... 其他议程
  }
  
  return score;
}
```

