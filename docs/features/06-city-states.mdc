## 十、城邦任务系统

城邦会发布任务，完成后获得额外使者。

```typescript
interface CityStateQuest {
  id: string;
  cityStateId: string;
  type: QuestType;
  target: any;
  reward: number;  // 使者数量
  expiresIn: number;  // 剩余回合
}

enum QuestType {
  SEND_TRADE_ROUTE = 'send_trade_route',   // 派遣贸易路线
  DESTROY_BARBARIAN = 'destroy_barbarian', // 消灭附近野蛮人
  TRAIN_UNIT = 'train_unit',               // 训练指定单位
  BUILD_WONDER = 'build_wonder',           // 建造奇观
  CONVERT_CITY = 'convert_city',           // 传播宗教
  GREAT_PERSON = 'great_person',           // 获得伟人
  RESEARCH_TECH = 'research_tech',         // 研究科技
  DISCOVER_NATURAL_WONDER = 'discover',    // 发现自然奇观
}

const QUEST_TEMPLATES: Record<CityStateType, QuestType[]> = {
  cultural: [QuestType.GREAT_PERSON, QuestType.BUILD_WONDER],
  industrial: [QuestType.TRAIN_UNIT, QuestType.BUILD_WONDER],
  militaristic: [QuestType.DESTROY_BARBARIAN, QuestType.TRAIN_UNIT],
  religious: [QuestType.CONVERT_CITY, QuestType.GREAT_PERSON],
  scientific: [QuestType.RESEARCH_TECH, QuestType.DISCOVER_NATURAL_WONDER],
  trade: [QuestType.SEND_TRADE_ROUTE, QuestType.GREAT_PERSON],
};
```

