## 十一、城邦战争与征服

```typescript
// 宣战城邦
function declareWarOnCityState(player: Player, cityState: CityState): void {
  // 与该城邦宗主国关系恶化
  if (cityState.suzerain && cityState.suzerain !== player.id) {
    modifyRelationship(player, cityState.suzerain, -30);
  }
  
  // 失去所有使者
  cityState.envoys[player.id] = 0;
  
  // 与所有派遣使者的文明关系略微恶化
  for (const [playerId, envoys] of Object.entries(cityState.envoys)) {
    if (envoys > 0 && playerId !== player.id) {
      modifyRelationship(player, playerId, -5);
    }
  }
}

// 征服城邦
function conquerCityState(player: Player, cityState: CityState): void {
  // 城邦变为玩家城市
  const newCity = convertToCity(cityState, player);
  
  // 城邦从游戏中移除
  cityState.isAlive = false;
  
  // 所有该城邦的加成失效
  // ...
}

// 解放城邦
function liberateCityState(player: Player, city: City): void {
  if (!city.originalCityState) return;
  
  // 恢复城邦
  const cityState = reviveCityState(city.originalCityState);
  
  // 解放者获得大量使者
  cityState.envoys[player.id] = (cityState.envoys[player.id] || 0) + 6;
  
  // 解放者自动成为宗主国
}
```
