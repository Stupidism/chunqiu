## 九、使者系统

```typescript
interface EnvoySystem {
  // 使者获取来源
  sources: EnvoySource[];
  
  // 使者派遣
  sendEnvoy(playerId: PlayerId, cityStateId: string): boolean;
  
  // 宗主国计算
  calculateSuzerain(cityState: CityState): PlayerId | null;
  
  // 加成计算
  calculateBonuses(playerId: PlayerId): CityStateBonus[];
}

enum EnvoySource {
  CIVIC_COMPLETED = 'civic_completed',       // 完成市政
  GOVERNMENT_CHANGE = 'government_change',   // 更换政府
  WONDER = 'wonder',                         // 奇观效果
  GREAT_PERSON = 'great_person',             // 伟人效果
  POLICY = 'policy',                         // 政策卡
  FIRST_MEET = 'first_meet',                 // 首次遇见
}

// 外交影响力 → 使者
function processInfluence(player: Player): void {
  const influencePerTurn = calculateInfluencePerTurn(player);
  player.influence += influencePerTurn;
  
  // 每100点外交影响力获得1使者
  while (player.influence >= 100) {
    player.influence -= 100;
    player.availableEnvoys++;
  }
}

// 宗主国判定
function calculateSuzerain(cityState: CityState): PlayerId | null {
  const envoyEntries = Object.entries(cityState.envoys);
  
  // 至少需要3使者才能成为宗主国
  const qualified = envoyEntries.filter(([_, count]) => count >= 3);
  if (qualified.length === 0) return null;
  
  // 排序
  qualified.sort((a, b) => b[1] - a[1]);
  
  // 必须比第二名多
  if (qualified.length > 1 && qualified[0][1] === qualified[1][1]) {
    return null; // 平局，无宗主国
  }
  
  return qualified[0][0] as PlayerId;
}
```

