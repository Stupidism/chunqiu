## 九、奇观竞争

```typescript
// 奇观被抢时的处理
function onWonderStolen(city: City, wonder: Wonder, stolenBy: Player): void {
  // 返还部分生产力
  const refund = Math.floor(city.wonderProgress[wonder.id] * 0.5);
  city.accumulatedProduction += refund;
  
  // 清除进度
  delete city.wonderProgress[wonder.id];
  
  // 通知玩家
  sendNotification(city.owner, {
    type: 'WONDER_STOLEN',
    message: `${wonder.name} 已被 ${stolenBy.civilization.name} 建造完成`,
    refund,
  });
}
```
