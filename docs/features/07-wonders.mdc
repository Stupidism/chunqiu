## 八、奇观建造逻辑

```typescript
function canBuildWonder(city: City, wonder: Wonder, player: Player): BuildResult {
  // 1. 检查是否已被建造
  if (isWonderBuilt(wonder.id)) {
    return { canBuild: false, reason: '该奇观已被其他文明建造' };
  }
  
  // 2. 检查科技/市政要求
  if (wonder.requiredTech && !player.hasTech(wonder.requiredTech)) {
    return { canBuild: false, reason: `需要科技：${getTechName(wonder.requiredTech)}` };
  }
  if (wonder.requiredCivic && !player.hasCivic(wonder.requiredCivic)) {
    return { canBuild: false, reason: `需要市政：${getCivicName(wonder.requiredCivic)}` };
  }
  
  // 3. 检查位置要求
  const validTiles = findValidTilesForWonder(city, wonder);
  if (validTiles.length === 0) {
    return { canBuild: false, reason: '没有符合条件的地块' };
  }
  
  return { canBuild: true, validTiles };
}

function findValidTilesForWonder(city: City, wonder: Wonder): Tile[] {
  const placement = wonder.placement;
  
  return city.ownedTiles.filter(tile => {
    // 地形检查
    if (placement.terrain && !placement.terrain.includes(tile.terrain)) return false;
    
    // 地貌检查
    if (placement.feature && tile.feature && !placement.feature.includes(tile.feature)) return false;
    if (placement.notFeature && tile.feature && placement.notFeature.includes(tile.feature)) return false;
    
    // 高度检查
    if (placement.flat && tile.elevation !== Elevation.FLAT) return false;
    if (placement.hills && tile.elevation !== Elevation.HILLS) return false;
    
    // 沿海/临河
    if (placement.coastal && !isCoastal(tile)) return false;
    if (placement.river && !isAdjacentToRiver(tile)) return false;
    
    // 区域检查
    if (placement.district && tile.district !== placement.district) return false;
    
    // 邻接检查
    if (placement.adjacent) {
      for (const adj of placement.adjacent) {
        const neighbors = getNeighbors(tile.position);
        const count = neighbors.filter(n => matchesAdjacency(n, adj)).length;
        if (count < (adj.count || 1)) return false;
      }
    }
    
    // 确保地块为空
    if (tile.improvement || tile.district || tile.wonder) return false;
    
    return true;
  });
}
```

