## 六、宗教胜利

```typescript
interface ReligionVictoryProgress {
  totalCivs: number;
  convertedCivs: number;
  progress: number; // 0-100%
  isVictory: boolean;
}

function checkReligionVictory(player: Player, game: Game): ReligionVictoryProgress {
  const playerReligion = player.religion;
  
  if (!playerReligion) {
    return {
      totalCivs: game.players.length,
      convertedCivs: 0,
      progress: 0,
      isVictory: false,
    };
  }
  
  let convertedCivs = 0;
  
  for (const civ of game.players) {
    if (civ.eliminated) continue;
    
    // 检查该文明是否以玩家宗教为主流
    let citiesWithMajority = 0;
    for (const city of civ.cities) {
      if (city.religion.majorityReligion === playerReligion.id) {
        citiesWithMajority++;
      }
    }
    
    // 超过一半城市信仰该宗教
    if (citiesWithMajority > civ.cities.length / 2) {
      convertedCivs++;
    }
  }
  
  const activeCivs = game.players.filter(p => !p.eliminated).length;
  const progress = (convertedCivs / activeCivs) * 100;
  
  return {
    totalCivs: activeCivs,
    convertedCivs,
    progress,
    isVictory: convertedCivs === activeCivs, // 所有文明都被转化
  };
}
```

