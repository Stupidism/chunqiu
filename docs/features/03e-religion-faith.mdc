## 四、宗教压力机制

### 压力来源

```typescript
interface ReligiousPressure {
  religionId: string;
  pressure: number;
}

interface CityReligion {
  pressures: ReligiousPressure[];
  majorityReligion: string | null;
  holyCity: boolean;
  followers: Record<string, number>; // 各宗教信徒数量
}

// 压力来源
enum PressureSource {
  PASSIVE = 'passive',         // 相邻城市被动传播
  HOLY_CITY = 'holy_city',     // 圣城额外压力
  MISSIONARY = 'missionary',   // 传教士主动传播
  APOSTLE = 'apostle',         // 使徒主动传播
  TRADE_ROUTE = 'trade_route', // 贸易路线
}

// 每回合压力计算
function calculateReligiousPressure(city: City, map: GameMap): ReligiousPressure[] {
  const pressures: Record<string, number> = {};
  
  // 1. 相邻城市被动传播（10格内）
  const nearbyCities = getNearbyCities(city.position, 10, map);
  for (const nearbyCity of nearbyCities) {
    if (nearbyCity.religion.majorityReligion) {
      const distance = getDistance(city.position, nearbyCity.position);
      const pressurePerTurn = Math.floor(8 / distance); // 距离越远压力越小
      pressures[nearbyCity.religion.majorityReligion] = 
        (pressures[nearbyCity.religion.majorityReligion] || 0) + pressurePerTurn;
    }
  }
  
  // 2. 圣城额外压力
  if (city.religion.holyCity) {
    const holyReligion = city.religion.majorityReligion;
    pressures[holyReligion] = (pressures[holyReligion] || 0) + 30;
  }
  
  // 3. 贸易路线压力
  for (const route of city.incomingTradeRoutes) {
    if (route.origin.religion.majorityReligion) {
      pressures[route.origin.religion.majorityReligion] = 
        (pressures[route.origin.religion.majorityReligion] || 0) + 1;
    }
  }
  
  return Object.entries(pressures).map(([religionId, pressure]) => ({
    religionId,
    pressure,
  }));
}
```

### 信徒计算

```typescript
// 根据压力计算信徒分布
function calculateFollowers(city: City): Record<string, number> {
  const totalPressure = city.religion.pressures.reduce((sum, p) => sum + p.pressure, 0);
  
  if (totalPressure === 0) {
    return {}; // 无宗教
  }
  
  const followers: Record<string, number> = {};
  
  for (const pressure of city.religion.pressures) {
    const ratio = pressure.pressure / totalPressure;
    followers[pressure.religionId] = Math.floor(city.population * ratio);
  }
  
  return followers;
}

// 判断主流宗教
function getMajorityReligion(city: City): string | null {
  const followers = calculateFollowers(city);
  const threshold = city.population / 2; // 超过50%
  
  for (const [religionId, count] of Object.entries(followers)) {
    if (count > threshold) {
      return religionId;
    }
  }
  
  return null;
}
```

### 传教士/使徒传播

```typescript
interface SpreadResult {
  pressureAdded: number;
  spreadChargesUsed: number;
  religionSpread: string;
}

function spreadReligion(unit: ReligiousUnit, city: City): SpreadResult {
  // 基础传播力
  let spreadStrength = 100;
  
  // 使徒能力加成
  if (unit.promotion === ApostlePromotion.PROSELYTIZER) {
    spreadStrength *= 2;
  }
  
  // 信条加成
  const religion = getReligion(unit.religionId);
  if (religion.enhancerBelief === 'scripture') {
    spreadStrength *= 1.25;
  }
  
  // 清真寺加成（传教士）
  if (unit.type === 'missionary' && religion.worshipBelief === 'mosque') {
    // 额外传播次数已在创建时添加
  }
  
  // 添加压力
  city.religion.pressures.push({
    religionId: unit.religionId,
    pressure: spreadStrength,
  });
  
  // 消耗传播次数
  unit.spreadsRemaining--;
  
  // 检查是否用完
  if (unit.spreadsRemaining <= 0) {
    // 单位消失
    removeUnit(unit);
  }
  
  return {
    pressureAdded: spreadStrength,
    spreadChargesUsed: 1,
    religionSpread: unit.religionId,
  };
}
```

