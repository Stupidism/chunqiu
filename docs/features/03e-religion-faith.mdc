## 五、神学战斗

```typescript
interface TheologicalCombatResult {
  winner: ReligiousUnit;
  loser: ReligiousUnit;
  winnerDamage: number;
  loserDamage: number;
  loserKilled: boolean;
  pressureSpread: ReligiousPressure[]; // 战斗结果导致的压力变化
}

function theologicalCombat(
  attacker: ReligiousUnit,
  defender: ReligiousUnit
): TheologicalCombatResult {
  // 只有使徒可以发起神学战斗
  if (attacker.type !== 'apostle') {
    throw new Error('Only apostles can initiate theological combat');
  }
  
  // 计算战斗力
  let attackerStrength = attacker.theologicalStrength;
  let defenderStrength = defender.theologicalStrength;
  
  // 使徒能力加成
  if (attacker.promotion === ApostlePromotion.DEBATER) {
    attackerStrength += 20;
  }
  if (defender.promotion === ApostlePromotion.DEBATER) {
    defenderStrength += 20;
  }
  
  // 地形加成（圣地所在格子）
  const attackerTile = getTile(attacker.position);
  const defenderTile = getTile(defender.position);
  
  if (attackerTile.district?.type === 'holy_site') {
    attackerStrength += 5;
  }
  if (defenderTile.district?.type === 'holy_site') {
    defenderStrength += 5;
  }
  
  // 伤害计算（类似常规战斗）
  const strengthDiff = attackerStrength - defenderStrength;
  const damageMultiplier = Math.pow(1.041, strengthDiff);
  
  const baseDamage = 30;
  const defenderDamage = Math.round(baseDamage * damageMultiplier);
  const attackerDamage = Math.round(baseDamage / damageMultiplier);
  
  // 应用伤害
  attacker.damage += attackerDamage;
  defender.damage += defenderDamage;
  
  // 判定胜负（谁先被消灭或伤害更重）
  const attackerKilled = attacker.damage >= 100;
  const defenderKilled = defender.damage >= 100;
  
  // 胜利者的宗教获得附近城市的压力加成
  const winner = defenderKilled || (!attackerKilled && defenderDamage > attackerDamage) 
    ? attacker : defender;
  const loser = winner === attacker ? defender : attacker;
  
  // 向附近城市传播胜利者宗教压力
  const nearbyCities = getNearbyCities(defender.position, 10);
  const pressureSpread: ReligiousPressure[] = [];
  
  for (const city of nearbyCities) {
    pressureSpread.push({
      religionId: winner.religionId,
      pressure: 100, // 基础传播量
    });
  }
  
  return {
    winner,
    loser,
    winnerDamage: winner === attacker ? attackerDamage : defenderDamage,
    loserDamage: winner === attacker ? defenderDamage : attackerDamage,
    loserKilled: winner === attacker ? defenderKilled : attackerKilled,
    pressureSpread,
  };
}
```

